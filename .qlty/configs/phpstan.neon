parameters:
    configDirectories:
        - %currentWorkingDirectory%/config

    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/database
        - %currentWorkingDirectory%/tests

    # The sandbox installs the analysis stack, not the project, so the package's
    # classes are autoloaded here for larastan, which instantiates models
    bootstrapFiles:
        - %currentWorkingDirectory%/.qlty/configs/autoload.php

    paths:
        - src
        - database
        - tests

    # Analyse at the supported PHP range, so 8.5-only features such as
    # #[\Override] on properties are not demanded of code that loads on 8.3.
    phpVersion:
        min: 80300
        max: 80599

    # Laravel 12 support keeps the floor below 13.2's model attributes. The
    # leading wildcard is needed because qlty stages the config elsewhere.
    ignoreErrors:
        -
            identifier: sineMaculaLaravel.modelAttributeLaggingFloor
            paths:
                - '*/src/Models/*'
                - '*/tests/*'
