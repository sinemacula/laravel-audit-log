root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
indent_size = unset

[*.{yml,yaml}]
indent_size = 2

# The OCSF licence keeps its own indentation.
[tests/Fixtures/Export/ocsf/1.9.0/LICENSE]
indent_size = unset
